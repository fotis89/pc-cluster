<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Cluster</AssemblyName>
    <RootNamespace>Cluster</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Cluster.ico</ApplicationIcon>

    <!-- The release workflow sets VersionPrefix/VersionSuffix from the git tag (v1.2.3-beta -> 1.2.3 + beta). -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <Product>Cluster</Product>
    <AssemblyTitle>Cluster</AssemblyTitle>
    <Description>Car-style CPU, RAM, disk and network gauges for Windows</Description>
    <Authors>Fotis Karagiorgos</Authors>
    <Copyright>Copyright (c) 2026 Fotis Karagiorgos</Copyright>
    <RepositoryUrl>https://github.com/fotis89/pc-cluster</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Footprint: one small workstation heap, no background GC thread. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <!-- Release: one self-contained exe, no .NET install needed. WPF doesn't support trimming. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- No compression: the zip is only ~2 MB bigger, and the runtime is mapped from the exe instead of
         being unpacked into RAM (83 MB vs 153 MB private memory). -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cluster.Tests" />
  </ItemGroup>

</Project>
